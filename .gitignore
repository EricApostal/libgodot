# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

/macos/libgodot.dylib
/macos/libgodot_core.dylib
# Copied from native/godot_core by macos/libgodot.podspec at `pod install` time (CocoaPods
# source_files can't reach outside the pod's own root, so this is the canonical copy CocoaPods
# actually compiles -- native/godot_core/ is the one to edit).
/macos/Classes/godot_core.h
/macos/Classes/godot_core.cpp
/macos/Classes/godot_core_desktop.cpp