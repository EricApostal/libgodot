{
    "version": 4,
    "configurations": [
        {
            "name": "macOS-clang++",
            "compilerPath": "/usr/bin/clang++",
            "cStandard": "c17",
            "cppStandard": "c++20",
            "intelliSenseMode": "macos-clang-arm64",
            "compileCommands": "${workspaceFolder}/packages/godot_dart/src/cpp/build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/packages/godot_dart/src/cpp",
                "${workspaceFolder}/packages/godot_dart/godot-cpp/include",
                "${workspaceFolder}/packages/godot_dart/godot-cpp/gdextension",
                "${workspaceFolder}/packages/godot_dart/src/cpp/build/godot-cpp/gen/include",
                "/Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include/c++/v1"
            ],
            "defines": [
                "DEBUG_ENABLED",
                "GDEXTENSION",
                "HOT_RELOAD_ENABLED",
                "MACOS_ENABLED",
                "THREADS_ENABLED",
                "UNIX_ENABLED"
            ],
            "forcedInclude": [],
            "browse": {
                "path": [
                    "${workspaceFolder}/packages/godot_dart/src/cpp",
                    "${workspaceFolder}/packages/godot_dart/godot-cpp/include",
                    "${workspaceFolder}/packages/godot_dart/godot-cpp/gdextension"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db"
            },
            "configurationProvider": "ms-vscode.cmake-tools"
        }
    ]
}